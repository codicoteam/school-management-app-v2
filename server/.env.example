PORT=3001
JWT_SECRET=replace-with-a-strong-random-secret

# Option A (cloud hosts like Render): a single connection string.
# SSL is enabled automatically; set DB_SSL=false to opt out.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option B (local dev): discrete settings. Set DB_SSL=true if the
# database requires SSL (e.g. connecting to Render from your machine).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_NAME=school_management
